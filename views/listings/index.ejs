<% layout('/layouts/boilerplate') %>

<div class="container-fluid px-lg-5">
    <!-- Category Filter Bar & Tax Toggle -->
    <div class="d-flex align-items-center justify-content-between flex-wrap border-bottom pb-2">
        <div id="filters">
            <a href="/listings" class="filter <%= (!selectedCategory || selectedCategory === 'All') ? 'active' : '' %>">
                <div><i class="fa-solid fa-compass"></i></div>
                <p>All</p>
            </a>
            <a href="/listings?category=Trending" class="filter <%= selectedCategory === 'Trending' ? 'active' : '' %>">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </a>
            <a href="/listings?category=Rooms" class="filter <%= selectedCategory === 'Rooms' ? 'active' : '' %>">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </a>
            <a href="/listings?category=Iconic Cities" class="filter <%= selectedCategory === 'Iconic Cities' ? 'active' : '' %>">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                <p>Iconic Cities</p>
            </a>
            <a href="/listings?category=Mountains" class="filter <%= selectedCategory === 'Mountains' ? 'active' : '' %>">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Mountains</p>
            </a>
            <a href="/listings?category=Castles" class="filter <%= selectedCategory === 'Castles' ? 'active' : '' %>">
                <div><i class="fa-brands fa-fort-awesome"></i></div>
                <p>Castles</p>
            </a>
            <a href="/listings?category=Amazing Pools" class="filter <%= selectedCategory === 'Amazing Pools' ? 'active' : '' %>">
                <div><i class="fa-solid fa-person-swimming"></i></div>
                <p>Amazing Pools</p>
            </a>
            <a href="/listings?category=Camping" class="filter <%= selectedCategory === 'Camping' ? 'active' : '' %>">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
            </a>
            <a href="/listings?category=Farms" class="filter <%= selectedCategory === 'Farms' ? 'active' : '' %>">
                <div><i class="fa-solid fa-cow"></i></div>
                <p>Farms</p>
            </a>
            <a href="/listings?category=Arctic" class="filter <%= selectedCategory === 'Arctic' ? 'active' : '' %>">
                <div><i class="fa-regular fa-snowflake"></i></div>
                <p>Arctic</p>
            </a>
            <a href="/listings?category=Beachfront" class="filter <%= selectedCategory === 'Beachfront' ? 'active' : '' %>">
                <div><i class="fa-solid fa-umbrella-beach"></i></div>
                <p>Beachfront</p>
            </a>
            <a href="/listings?category=Luxury" class="filter <%= selectedCategory === 'Luxury' ? 'active' : '' %>">
                <div><i class="fa-solid fa-gem"></i></div>
                <p>Luxury</p>
            </a>
        </div>

        <div class="tax-toggle my-2 ms-auto">
            <div class="form-check form-switch form-check-reverse m-0">
                <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
                <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
            </div>
        </div>
    </div>

    <!-- Active Search / Filter Badge notice -->
    <% if (searchQuery) { %>
        <div class="mt-3 mb-2 d-flex align-items-center justify-content-between">
            <h5>Results for "<strong><%= searchQuery %></strong>" (<%= allListings.length %> found)</h5>
            <a href="/listings" class="btn btn-sm btn-outline-secondary">Clear Filter</a>
        </div>
    <% } %>

    <!-- Listings Grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 mt-4 g-4">
        <% if (allListings.length === 0) { %>
            <div class="col-12 text-center py-5">
                <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3"></i>
                <h3>No exact matches found</h3>
                <p class="text-muted">Try changing or clearing some of your filters or searching for another destination.</p>
                <a href="/listings" class="btn btn-outline-dark mt-2">View All Listings</a>
            </div>
        <% } %>

        <% for (let listing of allListings) { %>
            <% 
                let avg = 0;
                if (listing.reviews && listing.reviews.length > 0) {
                    const total = listing.reviews.reduce((acc, r) => acc + (r.rating || 5), 0);
                    avg = (total / listing.reviews.length).toFixed(1);
                }
            %>
            <div class="col">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card listing-card h-100">
                        <div class="listing-img-container">
                            <img 
                                src="<%= listing.image.url %>" 
                                class="card-img-top" 
                                alt="<%= listing.title %>"
                                loading="lazy"
                                onerror="this.src='https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=80'"
                            >
                            <span class="category-badge"><%= listing.category || 'Trending' %></span>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="card-title text-truncate me-2"><%= listing.title %></div>
                                <div class="text-nowrap small">
                                    <i class="fa-solid fa-star text-danger small"></i>
                                    <%= avg > 0 ? avg : 'New' %>
                                </div>
                            </div>
                            <div class="card-location"><%= listing.location %>, <%= listing.country %></div>
                            <div class="card-price">
                                $<%= listing.price.toLocaleString("en-US") %>
                                <span>/ night</span>
                                <i class="tax-info text-muted fw-normal"> &nbsp;+18% GST ($<%= Math.round(listing.price * 1.18).toLocaleString("en-US") %> total)</i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
</div>
