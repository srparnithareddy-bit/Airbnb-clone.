<% layout('/layouts/boilerplate') %>

<div class="container my-4 px-lg-5">
    <!-- Header -->
    <div class="row">
        <div class="col-12 mb-3">
            <h2 class="fw-bold mb-1"><%= listing.title %></h2>
            <div class="d-flex align-items-center text-muted small flex-wrap gap-2">
                <% if (avgRating > 0) { %>
                    <span><i class="fa-solid fa-star text-danger"></i> <strong><%= avgRating %></strong> &middot; <%= listing.reviews.length %> reviews</span>
                    <span>&middot;</span>
                <% } else { %>
                    <span><i class="fa-solid fa-star text-danger"></i> <strong>New</strong></span>
                    <span>&middot;</span>
                <% } %>
                <span class="badge bg-light text-dark border"><%= listing.category %></span>
                <span>&middot;</span>
                <span class="text-decoration-underline"><%= listing.location %>, <%= listing.country %></span>
            </div>
        </div>
    </div>

    <!-- Image -->
    <div class="row mb-4">
        <div class="col-12">
            <img 
                src="<%= listing.image.url %>" 
                class="show-img" 
                alt="<%= listing.title %>"
                onerror="this.src='https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80'"
            >
        </div>
    </div>

    <!-- Main Content & Booking Widget -->
    <div class="row g-5">
        <!-- Left Column: Details -->
        <div class="col-lg-7">
            <!-- Host Info -->
            <div class="d-flex justify-content-between align-items-center pb-4 border-bottom">
                <div>
                    <h4 class="fw-bold mb-1">
                        Hosted by <%= listing.owner ? (listing.owner.fullName || listing.owner.username) : 'Airbnb Host' %>
                    </h4>
                    <p class="text-muted small mb-0">Superhost &middot; Dedicated experience &middot; Verified host</p>
                </div>
                <img 
                    src="<%= (listing.owner && listing.owner.avatar) ? listing.owner.avatar : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80' %>" 
                    alt="Host" 
                    class="host-avatar border"
                >
            </div>

            <!-- Features -->
            <div class="py-4 border-bottom">
                <div class="d-flex align-items-start mb-3">
                    <i class="fa-solid fa-door-open fs-4 me-3 text-muted"></i>
                    <div>
                        <h6 class="fw-bold mb-0">Self check-in</h6>
                        <small class="text-muted">Check yourself in with the keypad.</small>
                    </div>
                </div>
                <div class="d-flex align-items-start mb-3">
                    <i class="fa-solid fa-location-dot fs-4 me-3 text-muted"></i>
                    <div>
                        <h6 class="fw-bold mb-0">Great location</h6>
                        <small class="text-muted">95% of recent guests gave the location a 5-star rating.</small>
                    </div>
                </div>
                <div class="d-flex align-items-start">
                    <i class="fa-solid fa-calendar-check fs-4 me-3 text-muted"></i>
                    <div>
                        <h6 class="fw-bold mb-0">Free cancellation for 48 hours</h6>
                        <small class="text-muted">Full refund if you change your mind.</small>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="py-4 border-bottom">
                <h5 class="fw-bold mb-3">About this place</h5>
                <p style="white-space: pre-line; line-height: 1.6;"><%= listing.description %></p>
            </div>

            <!-- Amenities -->
            <div class="py-4 border-bottom">
                <h5 class="fw-bold mb-3">What this place offers</h5>
                <div class="row row-cols-2 g-3">
                    <div class="col"><i class="fa-solid fa-wifi me-2"></i> Fast Wifi</div>
                    <div class="col"><i class="fa-solid fa-tv me-2"></i> 65" 4K HDTV</div>
                    <div class="col"><i class="fa-solid fa-kitchen-set me-2"></i> Fully equipped kitchen</div>
                    <div class="col"><i class="fa-solid fa-square-parking me-2"></i> Free on-site parking</div>
                    <div class="col"><i class="fa-solid fa-snowflake me-2"></i> Air conditioning</div>
                    <div class="col"><i class="fa-solid fa-water-ladder me-2"></i> Private pool access</div>
                    <div class="col"><i class="fa-solid fa-fire-extinguisher me-2"></i> Smoke alarm & First aid</div>
                    <div class="col"><i class="fa-solid fa-shield-cat me-2"></i> Pet friendly</div>
                </div>
            </div>

            <!-- Owner Action Buttons (Edit / Delete) -->
            <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
                <div class="py-4 border-bottom d-flex gap-3">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">
                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
                    </a>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing? This action cannot be undone.');">
                        <button class="btn btn-outline-danger">
                            <i class="fa-solid fa-trash me-1"></i> Delete Listing
                        </button>
                    </form>
                </div>
            <% } %>
        </div>

        <!-- Right Column: Interactive Booking Widget -->
        <div class="col-lg-5">
            <div class="booking-widget-card">
                <div class="d-flex justify-content-between align-items-baseline mb-3">
                    <div>
                        <span class="fs-4 fw-bold" id="listingPricePerNight" data-price="<%= listing.price %>">
                            $<%= listing.price.toLocaleString("en-US") %>
                        </span>
                        <span class="text-muted"> / night</span>
                    </div>
                    <div class="small">
                        <i class="fa-solid fa-star text-danger"></i>
                        <strong><%= avgRating > 0 ? avgRating : 'New' %></strong>
                        <% if (listing.reviews.length > 0) { %>
                            &middot; <span class="text-muted"><%= listing.reviews.length %> reviews</span>
                        <% } %>
                    </div>
                </div>

                <!-- Booking Form -->
                <form action="/bookings/listings/<%= listing._id %>" method="POST" class="needs-validation" novalidate>
                    <div class="booking-dates-box p-2">
                        <div class="row g-2">
                            <div class="col-6 border-end">
                                <label for="bookingCheckIn" class="form-label text-muted small fw-bold mb-0">CHECK-IN</label>
                                <input type="date" class="form-control p-1" id="bookingCheckIn" name="booking[checkIn]" required>
                            </div>
                            <div class="col-6">
                                <label for="bookingCheckOut" class="form-label text-muted small fw-bold mb-0">CHECK-OUT</label>
                                <input type="date" class="form-control p-1" id="bookingCheckOut" name="booking[checkOut]" required>
                            </div>
                        </div>
                        <hr class="my-2">
                        <div>
                            <label for="bookingGuests" class="form-label text-muted small fw-bold mb-0">GUESTS</label>
                            <select class="form-select border-0 p-1" id="bookingGuests" name="booking[guestsCount]">
                                <option value="1" selected>1 guest</option>
                                <option value="2">2 guests</option>
                                <option value="3">3 guests</option>
                                <option value="4">4 guests</option>
                                <option value="5">5+ guests</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="specialRequests" class="form-label small text-muted">Special Requests (optional)</label>
                        <input type="text" class="form-control form-control-sm" id="specialRequests" name="booking[specialRequests]" placeholder="Early arrival, luggage dropoff...">
                    </div>

                    <% if (currUser) { %>
                        <button type="submit" class="booking-btn mb-3">Reserve Now</button>
                    <% } else { %>
                        <a href="/login" class="btn btn-outline-danger w-100 py-2 mb-3 fw-bold">Log in to Reserve</a>
                    <% } %>

                    <p class="text-center text-muted small mb-3">You won't be charged yet</p>

                    <!-- Real-Time Price Calculation Summary -->
                    <div id="bookingSummary" style="display: none;" class="border-top pt-3 small">
                        <div class="d-flex justify-content-between mb-2">
                            <span id="summaryNights">$<%= listing.price %> x 1 night</span>
                            <span id="summaryBasePrice">$<%= listing.price %></span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Cleaning & Service fee</span>
                            <span id="summaryServiceFee">$40</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Taxes & GST (18%)</span>
                            <span id="summaryTaxes">$<%= Math.round(listing.price * 0.18) %></span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold fs-6">
                            <span>Total before taxes & fees</span>
                            <span id="summaryTotalPrice" class="text-danger">$<%= listing.price %></span>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Reviews Section -->
    <div class="row my-5 pt-4 border-top">
        <div class="col-12">
            <h4 class="fw-bold mb-4">
                <i class="fa-solid fa-star text-danger me-2"></i>
                <%= avgRating > 0 ? `${avgRating} · ${listing.reviews.length} reviews` : 'No reviews yet' %>
            </h4>
        </div>

        <!-- Add Review Form (Only for logged in users) -->
        <div class="col-md-7 mb-5">
            <% if (currUser) { %>
                <div class="card p-4 shadow-sm border-0 bg-light">
                    <h5 class="fw-bold mb-3">Leave a Review & Rating</h5>
                    <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Rating</label>
                            <fieldset class="starability-slot">
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" checked />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                            </fieldset>
                        </div>
                        <div class="mb-3">
                            <label for="comment" class="form-label fw-semibold">Comments</label>
                            <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control" placeholder="Share details of your own experience at this place..." required></textarea>
                            <div class="invalid-feedback">Please write a brief comment for your review.</div>
                        </div>
                        <button class="btn btn-airbnb">Submit Review</button>
                    </form>
                </div>
            <% } else { %>
                <div class="alert alert-light border">
                    <a href="/login" class="fw-bold text-decoration-underline text-danger">Log in</a> to leave a review and rating for this stay.
                </div>
            <% } %>
        </div>

        <!-- All Reviews Cards -->
        <div class="col-12">
            <div class="row g-4">
                <% for (let review of listing.reviews) { %>
                    <div class="col-md-6">
                        <div class="review-card">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="d-flex align-items-center">
                                    <img 
                                        src="<%= (review.author && review.author.avatar) ? review.author.avatar : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80' %>" 
                                        alt="Author" 
                                        class="rounded-circle me-3" 
                                        style="width: 42px; height: 42px; object-fit: cover;"
                                    >
                                    <div>
                                        <h6 class="fw-bold mb-0"><%= review.author ? (review.author.fullName || review.author.username) : 'Guest' %></h6>
                                        <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %></small>
                                    </div>
                                </div>
                                <div class="star-rating-display">
                                    <% for (let i = 1; i <= 5; i++) { %>
                                        <i class="fa-solid fa-star <%= i <= review.rating ? 'text-danger' : 'text-secondary opacity-25' %>"></i>
                                    <% } %>
                                </div>
                            </div>
                            <p class="card-text mb-3 text-secondary" style="line-height: 1.5;"><%= review.comment %></p>

                            <!-- Delete Review Button (Author only) -->
                            <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash-can me-1"></i> Delete
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Map Section -->
    <div class="row my-5 pt-4 border-top">
        <div class="col-12">
            <h4 class="fw-bold mb-2">Where you'll be</h4>
            <p class="text-muted mb-4"><%= listing.location %>, <%= listing.country %></p>
            <div 
                id="map" 
                data-coordinates="<%= JSON.stringify(listing.geometry ? listing.geometry.coordinates : [2.3522, 48.8566]) %>"
                data-title="<%= listing.title %>"
                data-location="<%= listing.location %>, <%= listing.country %>"
            ></div>
        </div>
    </div>
</div>

<script src="/js/map.js"></script>
