<% layout('/layouts/boilerplate') %>

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="card p-4 p-md-5 shadow-sm border-0 rounded-4">
                <div class="mb-4">
                    <h2 class="fw-bold">Edit your listing</h2>
                    <p class="text-muted">Update details, pricing, photos, or description for your property.</p>
                </div>

                <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold">Title</label>
                        <input 
                            name="listing[title]" 
                            id="title" 
                            type="text" 
                            class="form-control form-control-lg" 
                            value="<%= listing.title %>" 
                            required
                        >
                        <div class="invalid-feedback">Please provide a descriptive title.</div>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">Description</label>
                        <textarea 
                            name="listing[description]" 
                            id="description" 
                            class="form-control" 
                            rows="4" 
                            required
                        ><%= listing.description %></textarea>
                        <div class="invalid-feedback">Please write a short description of the place.</div>
                    </div>

                    <!-- Current Image Preview -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold d-block">Current Cover Photo</label>
                        <img 
                            src="<%= originalImageUrl %>" 
                            alt="Current image" 
                            class="rounded-3 shadow-sm mb-2" 
                            style="height: 180px; width: 280px; object-fit: cover;"
                        >
                    </div>

                    <div class="mb-3">
                        <label for="image" class="form-label fw-semibold">Upload New Image (Optional)</label>
                        <input 
                            name="listing[image]" 
                            id="image" 
                            type="file" 
                            class="form-control" 
                            accept="image/*"
                        >
                        <small class="text-muted">Or enter a new image URL directly:</small>
                        <input 
                            name="listing[imageUrl]" 
                            type="url" 
                            class="form-control mt-2" 
                            placeholder="https://..."
                        >
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label for="category" class="form-label fw-semibold">Category</label>
                            <select name="listing[category]" id="category" class="form-select" required>
                                <% const categories = ['Trending', 'Rooms', 'Iconic Cities', 'Mountains', 'Castles', 'Amazing Pools', 'Camping', 'Farms', 'Arctic', 'Beachfront', 'Luxury']; %>
                                <% for (let cat of categories) { %>
                                    <option value="<%= cat %>" <%= listing.category === cat ? 'selected' : '' %>><%= cat %></option>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="price" class="form-label fw-semibold">Price per night ($ USD)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input 
                                    name="listing[price]" 
                                    id="price" 
                                    type="number" 
                                    min="0" 
                                    class="form-control" 
                                    value="<%= listing.price %>" 
                                    required
                                >
                            </div>
                            <div class="invalid-feedback">Please enter a valid price.</div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label for="location" class="form-label fw-semibold">City / Location</label>
                            <input 
                                name="listing[location]" 
                                id="location" 
                                type="text" 
                                class="form-control" 
                                value="<%= listing.location %>" 
                                required
                            >
                            <div class="invalid-feedback">Please enter the location.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="country" class="form-label fw-semibold">Country</label>
                            <input 
                                name="listing[country]" 
                                id="country" 
                                type="text" 
                                class="form-control" 
                                value="<%= listing.country %>" 
                                required
                            >
                            <div class="invalid-feedback">Please enter the country.</div>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-airbnb px-4 py-2">Save Changes</button>
                        <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
