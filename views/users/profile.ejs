<% layout('/layouts/boilerplate') %>

<div class="container my-5">
    <!-- User Profile Header -->
    <div class="row mb-5 align-items-center">
        <div class="col-md-3 text-center mb-3 mb-md-0">
            <img 
                src="<%= currUser.avatar || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80' %>" 
                alt="Profile photo" 
                class="rounded-circle shadow" 
                style="width: 130px; height: 130px; object-fit: cover;"
            >
        </div>
        <div class="col-md-9">
            <h2 class="fw-bold mb-1"><%= currUser.fullName || currUser.username %></h2>
            <p class="text-muted mb-2">@<%= currUser.username %> &middot; <%= currUser.email %></p>
            <p class="mb-3 text-secondary"><%= currUser.bio %></p>
            <div class="d-flex gap-2">
                <a href="/listings/new" class="btn btn-airbnb btn-sm">
                    <i class="fa-solid fa-plus me-1"></i> Add New Stay
                </a>
                <a href="/bookings" class="btn btn-outline-dark btn-sm">
                    <i class="fa-solid fa-suitcase-rolling me-1"></i> View Trips
                </a>
            </div>
        </div>
    </div>

    <!-- My Listings Section -->
    <div class="row pt-4 border-top">
        <div class="col-12 mb-4 d-flex justify-content-between align-items-center">
            <h4 class="fw-bold m-0">Properties Hosted by You (<%= myListings.length %>)</h4>
            <a href="/listings/new" class="btn btn-sm btn-outline-secondary">Add Another Listing</a>
        </div>

        <% if (myListings.length === 0) { %>
            <div class="col-12 text-center py-4 text-muted">
                <i class="fa-solid fa-house-chimney-user fa-3x mb-3 text-secondary opacity-50"></i>
                <h5>You haven't listed any stays yet</h5>
                <p>Start hosting and earn income by sharing your space on Airbnb.</p>
                <a href="/listings/new" class="btn btn-airbnb mt-2">Create Your First Listing</a>
            </div>
        <% } %>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            <% for (let listing of myListings) { %>
                <div class="col">
                    <div class="card listing-card h-100 shadow-sm border">
                        <div class="listing-img-container">
                            <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
                            <span class="category-badge"><%= listing.category %></span>
                        </div>
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-truncate mb-1"><%= listing.title %></h6>
                            <p class="text-muted small mb-2"><%= listing.location %>, <%= listing.country %></p>
                            <div class="fw-bold mb-3">$<%= listing.price %> <span class="fw-normal text-muted small">/ night</span></div>
                            <div class="d-flex gap-2">
                                <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-dark flex-fill">View</a>
                                <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-primary flex-fill">Edit</a>
                                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline flex-fill" onsubmit="return confirm('Delete this listing?');">
                                    <button class="btn btn-sm btn-outline-danger w-100">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>
