<% layout('/layouts/boilerplate') %>

<div class="container my-5">
    <div class="row">
        <div class="col-md-6 offset-md-3 col-lg-4 offset-lg-4">
            <div class="card p-4 p-md-4 shadow-sm border-0 rounded-4">
                <div class="text-center mb-4">
                    <i class="fa-brands fa-airbnb fa-3x text-danger mb-2"></i>
                    <h3 class="fw-bold">Sign up on Airbnb</h3>
                    <p class="text-muted small">Welcome! Create your account to start booking and hosting.</p>
                </div>

                <form action="/signup" method="POST" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="fullName" class="form-label fw-semibold small">Full Name</label>
                        <input 
                            name="fullName" 
                            id="fullName" 
                            type="text" 
                            class="form-control" 
                            placeholder="John Doe" 
                            required
                        >
                        <div class="invalid-feedback">Please enter your full name.</div>
                    </div>

                    <div class="mb-3">
                        <label for="username" class="form-label fw-semibold small">Username</label>
                        <input 
                            name="username" 
                            id="username" 
                            type="text" 
                            class="form-control" 
                            placeholder="johndoe12" 
                            required
                        >
                        <div class="invalid-feedback">Please choose a unique username.</div>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold small">Email Address</label>
                        <input 
                            name="email" 
                            id="email" 
                            type="email" 
                            class="form-control" 
                            placeholder="you@example.com" 
                            required
                        >
                        <div class="invalid-feedback">Please provide a valid email.</div>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label fw-semibold small">Password</label>
                        <input 
                            name="password" 
                            id="password" 
                            type="password" 
                            class="form-control" 
                            placeholder="Create a strong password" 
                            required
                        >
                        <div class="invalid-feedback">Password is required.</div>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-airbnb py-2">Continue</button>
                    </div>

                    <div class="text-center small text-muted">
                        Already have an account? <a href="/login" class="text-danger fw-bold text-decoration-none">Log in</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
