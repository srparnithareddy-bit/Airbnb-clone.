<% layout('/layouts/boilerplate') %>

<div class="container my-5">
    <div class="row">
        <div class="col-md-6 offset-md-3 col-lg-4 offset-lg-4">
            <div class="card p-4 p-md-4 shadow-sm border-0 rounded-4">
                <div class="text-center mb-4">
                    <i class="fa-brands fa-airbnb fa-3x text-danger mb-2"></i>
                    <h3 class="fw-bold">Welcome to Airbnb</h3>
                    <p class="text-muted small">Sign in to your account</p>
                </div>

                <form action="/login" method="POST" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="username" class="form-label fw-semibold small">Username</label>
                        <input 
                            name="username" 
                            id="username" 
                            type="text" 
                            class="form-control" 
                            placeholder="Enter your username" 
                            required
                        >
                        <div class="invalid-feedback">Username is required.</div>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label fw-semibold small">Password</label>
                        <input 
                            name="password" 
                            id="password" 
                            type="password" 
                            class="form-control" 
                            placeholder="Enter your password" 
                            required
                        >
                        <div class="invalid-feedback">Password is required.</div>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-airbnb py-2">Log In</button>
                    </div>

                    <div class="card bg-light p-3 border-0 small text-muted mb-3 text-start">
                        <strong><i class="fa-solid fa-key text-warning me-1"></i> Demo Host Account:</strong>
                        <div>Username: <code>demo_user</code></div>
                        <div>Password: <code>password123</code></div>
                    </div>

                    <div class="text-center small text-muted">
                        Don't have an account? <a href="/signup" class="text-danger fw-bold text-decoration-none">Sign up</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
